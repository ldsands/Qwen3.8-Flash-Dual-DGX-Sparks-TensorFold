+//! Storage ABI of the standalone Flash Next FP8 executable.
+pub const head_dim: usize = 256;
+pub const scale_bytes: usize = 4;
+pub const head_bytes: usize = head_dim + scale_bytes;
+pub const abi: u64 = 0x45344d33524f5731;
+
+pub fn rowBytes(heads: usize) usize {
+    return heads * head_bytes;
+}
+
+test "E4M3 storage includes one float scale per token and KV head" {
+    const std = @import("std");
+    try std.testing.expectEqual(@as(usize, 260), rowBytes(1));
+    try std.testing.expectEqual(@as(usize, 520), rowBytes(2));
+    try std.testing.expectEqual(@as(usize, 136314880), 262144 * rowBytes(2));
+}
+
+/// Independent scalar decoder for host references, including E4M3's two NaN codes.
+pub fn decode(code: u8, scale: f32) f32 {
+    const std = @import("std");
+    const e: u32 = (code >> 3) & 15;
+    const m: u32 = code & 7;
+    const value: f32 = if (e == 0) @as(f32, @floatFromInt(m)) * 0x1p-9 else if (e == 15 and m == 7) std.math.nan(f32) else @bitCast(((e + 120) << 23) | (m << 20));
+    return (if (code & 128 != 0) -value else value) * scale;
+}
+
+/// Nearest finite code, ties to even; deliberately scalar and used only by diagnostic references.
+pub fn encode(value: f32, scale: f32) u8 {
+    const std = @import("std");
+    const x = value / scale;
+    const bits: u32 = @bitCast(x);
+    const sign: u8 = @intCast((bits >> 24) & 128);
+    if (std.math.isNan(x)) return sign | 127;
+    const absolute = @min(@abs(x), 448.0);
+    var best: u8 = 0;
+    var distance: f64 = std.math.inf(f64);
+    for (0..127) |i| {
+        const code: u8 = @intCast(i);
+        const gap = @abs(@as(f64, absolute) - @as(f64, decode(code, 1)));
+        if (gap < distance or (gap == distance and code & 1 == 0)) {
+            best = code;
+            distance = gap;
+        }
+    }
+    return sign | best;
+}
+
+/// Match the device's BF16 input, one scale per head, then the BF16 MMA tile's dequantized values.
+pub fn roundTrip(rows: []u16) void {
+    const bf16 = @import("core").bf16_round;
+    var h: usize = 0;
+    while (h < rows.len) : (h += head_dim) {
+        const row = rows[h..][0..head_dim];
+        var maximum: f32 = 0;
+        for (row) |v| maximum = @max(maximum, @abs(bf16.value(v)));
+        const scale: f32 = if (maximum == 0) 1 else @max(maximum / 448.0, 0x1p-126);
+        for (row) |*v| v.* = bf16.bits(decode(encode(bf16.value(v.*), scale), scale));
+    }
+}
+
+/// Downloaded cache records have explicit byte payloads and float scales, never BF16 storage.
+pub fn read(rows: []u16, bytes: []const u8) void {
+    const std = @import("std");
+    const bf16 = @import("core").bf16_round;
+    for (rows, 0..) |*v, i| {
+        const record = bytes[(i / head_dim) * head_bytes ..][0..head_bytes];
+        const scale: f32 = @bitCast(std.mem.readInt(u32, record[head_dim..][0..4], .little));
+        v.* = bf16.bits(decode(record[i % head_dim], scale));
+    }
+}
+
+test "E4M3 storage scalar reference preserves codes, signs, ties and saturation" {
+    const std = @import("std");
+    for (0..256) |i| {
+        const code: u8 = @intCast(i);
+        if (code & 127 == 127) {
+            try std.testing.expect(std.math.isNan(decode(code, 3.25)));
+        } else try std.testing.expectEqual(code, encode(decode(code, 3.25), 3.25));
+    }
+    try std.testing.expectEqual(@as(u8, 56), encode(1.0625, 1));
+    try std.testing.expectEqual(@as(u8, 58), encode(1.1875, 1));
+    try std.testing.expectEqual(@as(u8, 126), encode(1e10, 1));
+    try std.testing.expectEqual(@as(u8, 254), encode(-1e10, 1));
+}
+
+test "E4M3 storage records keep independent head scales through download" {
+    const std = @import("std");
+    const bf16 = @import("core").bf16_round;
+    var bytes: [2 * head_bytes]u8 = @splat(56);
+    for (0..2) |h| {
+        const scale: f32 = @floatFromInt(h + 1);
+        std.mem.writeInt(u32, bytes[h * head_bytes + head_dim ..][0..4], @bitCast(scale), .little);
+    }
+    var rows: [2 * head_dim]u16 = undefined;
+    read(&rows, &bytes);
+    for (rows, 0..) |v, i| try std.testing.expectEqual(bf16.bits(@floatFromInt(i / head_dim + 1)), v);
+    const original = rows;
+    roundTrip(&rows);
+    try std.testing.expectEqualSlices(u16, &original, &rows);
+    @memset(&rows, 0);
+    roundTrip(&rows);
+    for (rows) |v| try std.testing.expectEqual(@as(u16, 0), v);
+}
