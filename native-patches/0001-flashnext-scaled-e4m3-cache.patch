+// One E4M3 row per token/head: 256 encoded bytes followed by an aligned float dequantization scale.
+#pragma once
+#include <cuda_fp8.h>
+
+namespace fn_kv8 {
+constexpr int width = 256;
+constexpr int row_bytes = width + sizeof(float);
+
+__host__ __device__ inline uint8_t encode(float x, float scale) {
+    return __nv_cvt_float_to_fp8(x / scale, __NV_SATFINITE, __NV_E4M3);
+}
+
+__host__ __device__ inline float decode(uint8_t x, float scale) {
+    __nv_fp8_e4m3 v;
+    v.__x = x;
+    return static_cast<float>(v) * scale;
+}
+
+__host__ __device__ inline float scale(float maximum) {
+    return maximum == 0 ? 1.0f : fmaxf(maximum / 448.0f, 0x1p-126f);
+}
+
+#if defined(__CUDACC__)
+// Every one of the 256 threads owns one element; all participate in both scale reductions.
+__device__ __forceinline__ void store(uint8_t* cache, long long slot, int d, float x, float* scratch) {
+    float m = fabsf(x);
+    for (int off = 16; off; off >>= 1) m = fmaxf(m, __shfl_down_sync(0xffffffff, m, off));
+    if ((d & 31) == 0) scratch[d >> 5] = m;
+    __syncthreads();
+    if (d == 0) {
+        float maximum = 0;
+        for (int w = 0; w < 8; ++w) maximum = fmaxf(maximum, scratch[w]);
+        // The zero row has scale one. A floor avoids underflow on subnormal inputs.
+        scratch[8] = scale(maximum);
+        *reinterpret_cast<float*>(cache + slot * row_bytes + width) = scratch[8];
+    }
+    __syncthreads();
+    cache[slot * row_bytes + d] = encode(x, scratch[8]);
+    __syncthreads();
+}
+
+__device__ __forceinline__ __nv_bfloat16 load(const uint8_t* cache, long long slot, int d) {
+    const uint8_t* row = cache + slot * row_bytes;
+    const float scale = *reinterpret_cast<const float*>(row + width);
+    return __float2bfloat16_rn(decode(row[d], scale));
+}
+
+// Dequantize into the existing BF16 MMA tiles; no encoded byte is ever read as a BF16 element.
+__device__ __forceinline__ void load8(__nv_bfloat16* dst, const uint8_t* cache, long long slot, int d, bool live) {
+    for (int i = 0; i < 8; ++i) dst[i] = live ? load(cache, slot, d + i) : __float2bfloat16_rn(0.0f);
+}
+#endif
+}  // namespace fn_kv8
